# ─────────────────────────────────────────────────────────────
# ClinicDesk — environment
#
# Copy to .env.local. These are exactly the variables validated in
# src/lib/env/server.ts; the app refuses to start if one is missing or
# malformed. Later phases add mail (Phase 1), CRON_SECRET and
# TRIAL_CLAIM_SECRET (plan §22, §7.6) here as they are needed.
#
# There is no database connection string: the app talks to Supabase over its
# API, and schema changes go through the Supabase CLI (`npm run db:reset`
# locally, `supabase db push` to a linked project).
# ─────────────────────────────────────────────────────────────

# ── Supabase: local (Docker) ─────────────────────────────────
# `npm run db:start` prints these. The keys are the well-known demo keys every
# local Supabase uses, so they are not secrets. ClinicDesk's local stack runs
# on 553xx ports, so it can run beside other local Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Supabase: hosted (production) ────────────────────────────
# From the project's Settings → API (Mumbai, ap-south-1). The service-role key
# bypasses row-level security: a real secret, never committed, never sent to
# the browser. Production values live in Vercel and GitHub secrets.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Application ──────────────────────────────────────────────
# Where this app is reachable; links in emails are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
