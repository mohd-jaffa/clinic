# ─────────────────────────────────────────────────────────────
# ClinicDesk — environment
#
# Copy to .env.local. These are exactly the variables validated in
# src/lib/env/server.ts; the app refuses to start if one is missing or
# malformed.
#
# There is no database connection string: the app talks to Supabase over its
# API, and schema changes go through the Supabase CLI (`npm run db:reset`
# locally, `supabase db push` to a linked project).
# ─────────────────────────────────────────────────────────────

# ── Supabase: local (Docker) ─────────────────────────────────
# `npm run db:start` prints these. The keys are the well-known demo keys every
# local Supabase uses, so they are not secrets. ClinicDesk's local stack runs
# on 553xx ports, so it can run beside other local Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Supabase: hosted (production) ────────────────────────────
# From the project's Settings → API (Mumbai, ap-south-1). The service-role key
# bypasses row-level security: a real secret, never committed, never sent to
# the browser. Production values live in Vercel and GitHub secrets.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Application ──────────────────────────────────────────────
# Where this app is reachable; links in emails are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mail ─────────────────────────────────────────────────────
# The app sends its own email (plan §22). Locally: Mailpit, started with the
# local Supabase; nothing leaves the machine — read what was sent at
# http://127.0.0.1:55324. Unset SMTP_HOST, and mail is off: sign-up still
# works, and Resend says mail could not be sent.
SMTP_HOST=127.0.0.1
SMTP_PORT=55325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ClinicDesk <no-reply@clinicdesk.local>"

# Production: a Gmail made only for the app's mail, signed in with an app
# password (D20). SMTP_FROM must be that same address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=<the Gmail address>
# SMTP_PASSWORD=<the app password, without spaces>
# SMTP_FROM="ClinicDesk <the Gmail address>"

# ── Trial claims ─────────────────────────────────────────────
# Keys the HMAC that remembers which owner mobiles have had a free trial
# (plan §7.6) without storing the numbers. At least 32 characters. The value
# below is for this machine only; production's is a real secret
# (`openssl rand -hex 32`), set once and never changed — a new one forgets
# every claim.
TRIAL_CLAIM_SECRET=local-only-trial-claim-secret-not-for-production

# ── The daily plan emails ────────────────────────────────────
# What the database's scheduler (pg_cron, through pg_net) sends to
# POST /api/cron/subscription-notices every day at 9:00 India time (plan §22).
# At least 32 characters (`openssl rand -hex 32`). Unset, the route answers no
# one — locally the job finds nothing in Vault and calls nothing anyway. In
# production the same value, and the route's address, go into Supabase Vault
# (never a migration):
#   select vault.create_secret('https://<app>/api/cron/subscription-notices', 'subscription_notices_url');
#   select vault.create_secret('<CRON_SECRET>', 'cron_secret');
# CRON_SECRET=
