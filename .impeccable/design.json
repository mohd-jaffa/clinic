  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Button variant primary: the green capsule with its ink chip trailing; the one thing to do.",
      "html": "<button class=\"ds-btn-primary\">Sign in<span class=\"ds-chip\" aria-hidden=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></span></button>",
      "css": ".ds-btn-primary{position:relative;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 49px 0 18px;border:0;border-radius:9999px;background:var(--action);color:var(--on-action);font:700 1.0625rem/1.5 var(--font-sans,Figtree,system-ui,sans-serif);white-space:nowrap;cursor:pointer;transition:padding 260ms cubic-bezier(0.22,1,0.36,1),transform 260ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary .ds-chip{position:absolute;top:50%;left:calc(100% - 39px);transform:translateY(-50%);display:grid;place-items:center;width:34px;height:34px;border-radius:9999px;background:var(--chip);color:var(--on-chip);transition:left 260ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:3px solid var(--action);outline-offset:3px}"
