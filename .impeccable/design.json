      "html": "<ul class=\"ds-menu\"><li class=\"ds-menu-row\"><svg class=\"ds-menu-icon\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z\"/></svg><span class=\"ds-menu-text\"><b>Price list</b><small>Services and what they cost</small></span><span class=\"ds-chev\">&#8250;</span></li><li class=\"ds-menu-row\"><svg class=\"ds-menu-icon ds-coral\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18\"/><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/><path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/></svg><span class=\"ds-menu-text\"><b>Delete clinic</b><small>Ask to delete the clinic</small></span><span class=\"ds-chev\">&#8250;</span></li></ul>",
