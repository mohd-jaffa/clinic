      "kind": "nav",
      "refersTo": "add-button-bar",
      "description": "AppShell phone bottom bar: four places and the raised land ＋ in the centre; the current place on a land patch.",
      "html": "<nav class=\"ds-bar\"><a class=\"ds-place ds-on\"><span class=\"ds-patch\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\"><path d=\"M3 10l9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg></span>Home</a><a class=\"ds-place\"><span class=\"ds-patch\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\"><path d=\"M10 6h11M10 12h11M10 18h11M4 6h1M4 12h1M4 18h1\"/></svg></span>Queue</a><button class=\"ds-add\"><span class=\"ds-plus\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span>Add</button><a class=\"ds-place\"><span class=\"ds-patch\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\"><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2\"/></svg></span>Patients</a><a class=\"ds-place\"><span class=\"ds-patch\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></span>More</a></nav>",
      "css": ".ds-bar{display:grid;grid-template-columns:repeat(5,1fr);height:64px;border-top:1px solid var(--line);background:var(--ground);font-family:var(--font-sans,Figtree,system-ui,sans-serif);font-size:.75rem;line-height:1}.ds-place{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:var(--muted);text-decoration:none;cursor:pointer}.ds-patch{display:grid;place-items:center;width:56px;height:32px;border-radius:9999px;transition:background-color 260ms cubic-bezier(0.22,1,0.36,1)}.ds-on{color:var(--ink);font-weight:700}.ds-on .ds-patch{background:var(--land);color:var(--land-ink)}.ds-place:hover .ds-patch{color:var(--ink)}.ds-add{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px;padding:0 0 8px;border:0;background:none;color:var(--ink);font:inherit;font-weight:700;cursor:pointer}.ds-plus{display:grid;place-items:center;width:60px;height:60px;border-radius:9999px;background:var(--land);color:var(--land-ink);box-shadow:0 0 0 6px var(--ground);transition:transform 260ms cubic-bezier(0.22,1,0.36,1)}.ds-add:active .ds-plus{transform:scale(.95)}.ds-add:focus-visible,.ds-place:focus-visible{outline:3px solid var(--action);outline-offset:3px}"
