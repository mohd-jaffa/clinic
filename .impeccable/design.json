      "css": ".ds-row{display:flex;align-items:center;gap:12px;min-height:64px;padding:10px 8px 10px 14px;border-radius:1.375rem;background:var(--surface);color:var(--ink);font-family:var(--font-sans,Figtree,system-ui,sans-serif);transition:box-shadow 150ms}.ds-row:hover{box-shadow:inset 0 0 0 2px var(--line)}.ds-token{min-width:40px;font-size:1.875rem;line-height:.95;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-row-text{display:flex;flex-direction:column}.ds-row-text small{font-size:.9375rem;color:var(--muted);font-variant-numeric:tabular-nums}"
